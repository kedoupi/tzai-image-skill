#!/usr/bin/env bash
# tzai-image — generate images via TaoziAPI (https://tzai.kdp.cool)
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
SKILL_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd -P)"
SKILL_NAME="$(basename -- "$SKILL_ROOT")"
SKILLS_PARENT="$(dirname -- "$SKILL_ROOT")"

DURABLE_CONFIG_DIR="${SKILLS_PARENT}/.skill-data/${SKILL_NAME}"
DURABLE_CONFIG_FILE="${DURABLE_CONFIG_DIR}/config.env"
GLOBAL_SHARED_CONFIG_FILE="${HOME}/.agents/skills/.skill-data/${SKILL_NAME}/config.env"
LOCAL_CONFIG_FILE="${SKILL_ROOT}/config.local.env"
XDG_CONFIG_FILE="${HOME}/.config/${SKILL_NAME}/config.env"
EXAMPLE_CONFIG_FILE="${SKILL_ROOT}/config.example.env"
SKILL_MD_FILE="${SKILL_ROOT}/SKILL.md"
KINDS_FILE="${SKILL_ROOT}/references/kinds.tsv"
PRESETS_DIR="${SKILL_ROOT}/references/presets"
WORKFLOWS_DIR="${SKILL_ROOT}/references/workflows"

DEFAULT_BASE_URL="https://tzai.kdp.cool"
# Best image model currently available on TaoziAPI (override via env/CLI if needed).
DEFAULT_IMAGE_MODEL="gpt-image-2"
DEFAULT_AR="1:1"
DEFAULT_TIMEOUT=120
CONSOLE_URL="https://tzai.kdp.cool/console"

# Scenario kinds (like baoyu-xhs / infographic / diagram modules, but one CLI)
KIND_IDS="icon logo moodboard mascot badge avatar flowchart architecture mindmap diagram infographic dataviz ui wireframe empty-state onboarding slide banner email-header cover poster xhs xhs-cover wechat product photo landscape illustration storybook food"

# Snapshot process env so files cannot clobber exported globals (plan: env > files).
_ENV_API_KEY="${TZAI_API_KEY-}"
_ENV_BASE_URL="${TZAI_BASE_URL-}"
_ENV_MODEL="${TZAI_IMAGE_MODEL-}"
_ENV_AR="${TZAI_DEFAULT_AR-}"
_ENV_TIMEOUT="${TZAI_TIMEOUT_SEC-}"
_ENV_HAD_API_KEY=0
_ENV_HAD_BASE_URL=0
_ENV_HAD_MODEL=0
_ENV_HAD_AR=0
_ENV_HAD_TIMEOUT=0
[[ -n "${TZAI_API_KEY+x}" && -n "${TZAI_API_KEY-}" ]] && _ENV_HAD_API_KEY=1
[[ -n "${TZAI_BASE_URL+x}" && -n "${TZAI_BASE_URL-}" ]] && _ENV_HAD_BASE_URL=1
[[ -n "${TZAI_IMAGE_MODEL+x}" && -n "${TZAI_IMAGE_MODEL-}" ]] && _ENV_HAD_MODEL=1
[[ -n "${TZAI_DEFAULT_AR+x}" && -n "${TZAI_DEFAULT_AR-}" ]] && _ENV_HAD_AR=1
[[ -n "${TZAI_TIMEOUT_SEC+x}" && -n "${TZAI_TIMEOUT_SEC-}" ]] && _ENV_HAD_TIMEOUT=1

# Effective key source for doctor/which-config: file | env | cli | unset
KEY_SOURCE="unset"
BASE_SOURCE="default"
MODEL_SOURCE="unset"

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

require_val() {
  local opt="$1"
  if [[ $# -lt 2 ]]; then
    echo "Missing value for $opt" >&2
    exit 2
  fi
  if [[ -z "$2" ]]; then
    echo "Empty value for $opt" >&2
    exit 2
  fi
}

skill_version() {
  local v=""
  if [[ -f "$SKILL_MD_FILE" ]]; then
    v="$(sed -nE 's/^[[:space:]]*version:[[:space:]]*"([^"]+)".*/\1/p' "$SKILL_MD_FILE" | head -n1)"
  fi
  printf '%s' "${v:-0.1.0}"
}

mask_key() {
  local k="${1-}"
  if [[ -z "$k" ]]; then
    printf '(unset)'
    return
  fi
  if [[ ${#k} -le 8 ]]; then
    printf '****'
    return
  fi
  printf '%s…%s' "${k:0:4}" "${k: -4}"
}

print_key_howto() {
  cat <<EOF >&2
No API key found.

Get a key:
  1) Open ${CONSOLE_URL}
  2) Sign in / register, create an API token

Configure (pick one):
  A) Global env (recommended for shell users):
       export TZAI_API_KEY='sk-...'
  B) Durable file (recommended for agents):
       bash ${SCRIPT_DIR}/tzai-image init --api-key sk-...
  C) One-shot CLI:
       bash ${SCRIPT_DIR}/tzai-image generate --api-key sk-... --prompt "..." --image out.png

Never commit the key or put it only inside the skill package (wiped by npx skills update).
EOF
}

load_env_file() {
  local file="$1"
  [[ -f "$file" ]] || return 0
  local was_a=0
  [[ $- == *a* ]] && was_a=1
  set -a
  # shellcheck disable=SC1090
  source "$file"
  if (( ! was_a )); then
    set +a
  fi
}

# Files first, then re-apply process env (env wins over files).
# Then optional TZAI_IMAGE_CONFIG (explicit path, overrides env).
load_all_configs() {
  TZAI_BASE_URL="${DEFAULT_BASE_URL}"
  TZAI_IMAGE_MODEL="${DEFAULT_IMAGE_MODEL}"
  TZAI_DEFAULT_AR="${DEFAULT_AR}"
  TZAI_TIMEOUT_SEC="${DEFAULT_TIMEOUT}"
  KEY_SOURCE="unset"
  BASE_SOURCE="default"
  MODEL_SOURCE="default"

  load_env_file "$XDG_CONFIG_FILE"
  load_env_file "$GLOBAL_SHARED_CONFIG_FILE"
  if [[ "$DURABLE_CONFIG_FILE" != "$GLOBAL_SHARED_CONFIG_FILE" ]]; then
    load_env_file "$DURABLE_CONFIG_FILE"
  fi
  load_env_file "$LOCAL_CONFIG_FILE"

  if [[ -n "${TZAI_API_KEY-}" ]]; then
    KEY_SOURCE="file"
  fi
  if [[ "${TZAI_BASE_URL}" != "${DEFAULT_BASE_URL}" ]]; then
    BASE_SOURCE="file"
  fi
  if [[ -n "${TZAI_IMAGE_MODEL-}" && "${TZAI_IMAGE_MODEL}" != "${DEFAULT_IMAGE_MODEL}" ]]; then
    MODEL_SOURCE="file"
  fi

  # Process env overrides files
  if [[ "$_ENV_HAD_API_KEY" -eq 1 ]]; then
    TZAI_API_KEY="$_ENV_API_KEY"
    KEY_SOURCE="env"
  fi
  if [[ "$_ENV_HAD_BASE_URL" -eq 1 ]]; then
    TZAI_BASE_URL="$_ENV_BASE_URL"
    BASE_SOURCE="env"
  fi
  if [[ "$_ENV_HAD_MODEL" -eq 1 ]]; then
    TZAI_IMAGE_MODEL="$_ENV_MODEL"
    MODEL_SOURCE="env"
  fi
  if [[ "$_ENV_HAD_AR" -eq 1 ]]; then
    TZAI_DEFAULT_AR="$_ENV_AR"
  fi
  if [[ "$_ENV_HAD_TIMEOUT" -eq 1 ]]; then
    TZAI_TIMEOUT_SEC="$_ENV_TIMEOUT"
  fi

  # Explicit config file path overrides env
  if [[ -n "${TZAI_IMAGE_CONFIG-}" && -f "${TZAI_IMAGE_CONFIG}" ]]; then
    load_env_file "$TZAI_IMAGE_CONFIG"
    if [[ -n "${TZAI_API_KEY-}" ]]; then
      KEY_SOURCE="explicit-file"
    fi
    if [[ -n "${TZAI_BASE_URL-}" ]]; then
      BASE_SOURCE="explicit-file"
    fi
    if [[ -n "${TZAI_IMAGE_MODEL-}" ]]; then
      MODEL_SOURCE="explicit-file"
    fi
  fi

  # Built-in best default if still empty after all layers
  if [[ -z "${TZAI_IMAGE_MODEL-}" ]]; then
    TZAI_IMAGE_MODEL="${DEFAULT_IMAGE_MODEL}"
    MODEL_SOURCE="default"
  fi

  # Normalize base URL (strip trailing slash)
  TZAI_BASE_URL="${TZAI_BASE_URL%/}"
}

print_config_paths() {
  cat <<EOF
Skill root:           ${SKILL_ROOT}
Version:              $(skill_version)
Durable config:       ${DURABLE_CONFIG_FILE}$([[ -f "$DURABLE_CONFIG_FILE" ]] && echo "  [exists]" || echo "  [missing]")
Global shared config: ${GLOBAL_SHARED_CONFIG_FILE}$([[ -f "$GLOBAL_SHARED_CONFIG_FILE" ]] && echo "  [exists]" || echo "  [missing]")
Local (in skill):     ${LOCAL_CONFIG_FILE}$([[ -f "$LOCAL_CONFIG_FILE" ]] && echo "  [exists · wiped on skills update]" || echo "  [missing]")
XDG legacy:           ${XDG_CONFIG_FILE}$([[ -f "$XDG_CONFIG_FILE" ]] && echo "  [exists]" || echo "  [missing]")
Explicit override:    ${TZAI_IMAGE_CONFIG:-"(unset)"}
EOF
}

ar_to_size() {
  local ar="${1:-1:1}"
  case "$ar" in
    1:1) echo "1024x1024" ;;
    16:9) echo "1792x1024" ;;
    9:16) echo "1024x1792" ;;
    4:3) echo "1536x1152" ;;
    3:4) echo "1152x1536" ;;
    3:2) echo "1536x1024" ;;
    2:3) echo "1024x1536" ;;
    *) echo "1024x1024" ;;
  esac
}

# kinds.tsv: id category category_zh ar label_en label_zh prefix
kind_line() {
  local id="$1"
  [[ -f "$KINDS_FILE" ]] || return 1
  # shellcheck disable=SC2016
  awk -F'\t' -v id="$id" '
    $0 ~ /^#/ || NF < 7 { next }
    $1 == id {
      print $0
      found=1
      exit
    }
    END { exit found ? 0 : 1 }
  ' "$KINDS_FILE"
}

kind_field() {
  # kind_field <line> <1-based index>
  local line="$1" idx="$2"
  printf '%s\n' "$line" | awk -F'\t' -v i="$idx" '{print $i}'
}

# TSV helpers: id is column 1; field is 1-based
preset_field() {
  local file="$1" id="$2" idx="$3"
  [[ -f "$file" ]] || return 1
  awk -F'\t' -v id="$id" -v i="$idx" '
    $0 ~ /^#/ || NF < 2 { next }
    $1 == id {
      print $i
      found=1
      exit
    }
    END { exit found ? 0 : 1 }
  ' "$file"
}

preset_exists() {
  local file="$1" id="$2"
  preset_field "$file" "$id" 1 >/dev/null 2>&1
}

list_preset_ids() {
  local file="$1"
  [[ -f "$file" ]] || return 0
  awk -F'\t' '
    $0 ~ /^#/ || NF < 2 { next }
    { printf "%s\t%s\n", $1, $2 }
  ' "$file"
}

# Resolve named combo for xhs: id → style layout palette
apply_xhs_named_preset() {
  # sets: style layout palette (by name reference via globals STYLE LAYOUT PALETTE)
  local pid="$1"
  local line st la pa
  line="$(awk -F'\t' -v id="$pid" '
    $0 ~ /^#/ || NF < 4 { next }
    $1 == id { print; found=1; exit }
    END { exit found ? 0 : 1 }
  ' "${PRESETS_DIR}/xhs-presets.tsv")" || {
    echo "Unknown --preset: $pid (try: tzai-image presets xhs)" >&2
    return 2
  }
  st="$(printf '%s\n' "$line" | awk -F'\t' '{print $2}')"
  la="$(printf '%s\n' "$line" | awk -F'\t' '{print $3}')"
  pa="$(printf '%s\n' "$line" | awk -F'\t' '{print $4}')"
  [[ -n "$st" && -z "${STYLE:-}" ]] && STYLE="$st"
  [[ -n "$la" && -z "${LAYOUT:-}" ]] && LAYOUT="$la"
  [[ -n "$pa" && -z "${PALETTE:-}" ]] && PALETTE="$pa"
  return 0
}

direction_or_fail() {
  local file="$1" id="$2" what="$3"
  local d
  d="$(preset_field "$file" "$id" 3)" || {
    echo "Unknown ${what}: $id (try: tzai-image presets)" >&2
    return 2
  }
  printf '%s' "$d"
}

# Resolve matrix knobs in the CURRENT shell (must not run under $()).
# Mutates: STYLE LAYOUT PALETTE CTYPE RENDERING TEXTLEVEL MOOD
resolve_matrix_knobs() {
  case "${KIND:-}" in
    xhs|xhs-cover)
      if [[ -n "${PRESET:-}" ]]; then
        apply_xhs_named_preset "$PRESET" || return 2
      fi
      if [[ -n "${STYLE:-}${LAYOUT:-}${PALETTE:-}${PRESET:-}" ]]; then
        STYLE="${STYLE:-cute}"
        LAYOUT="${LAYOUT:-balanced}"
      fi
      # validate if set
      if [[ -n "${STYLE:-}" ]]; then
        direction_or_fail "${PRESETS_DIR}/xhs-styles.tsv" "$STYLE" "style" >/dev/null || return 2
      fi
      if [[ -n "${LAYOUT:-}" ]]; then
        direction_or_fail "${PRESETS_DIR}/xhs-layouts.tsv" "$LAYOUT" "layout" >/dev/null || return 2
      fi
      if [[ -n "${PALETTE:-}" ]]; then
        direction_or_fail "${PRESETS_DIR}/xhs-palettes.tsv" "$PALETTE" "palette" >/dev/null || return 2
      fi
      ;;
    infographic)
      if [[ -n "${STYLE:-}${LAYOUT:-}" ]]; then
        STYLE="${STYLE:-clean-corporate}"
        LAYOUT="${LAYOUT:-bento}"
      fi
      if [[ -n "${STYLE:-}" ]]; then
        direction_or_fail "${PRESETS_DIR}/infographic-styles.tsv" "$STYLE" "style" >/dev/null || return 2
      fi
      if [[ -n "${LAYOUT:-}" ]]; then
        direction_or_fail "${PRESETS_DIR}/infographic-layouts.tsv" "$LAYOUT" "layout" >/dev/null || return 2
      fi
      ;;
    cover)
      if [[ -n "${CTYPE:-}${PALETTE:-}${RENDERING:-}${TEXTLEVEL:-}${MOOD:-}" ]]; then
        CTYPE="${CTYPE:-hero}"
        PALETTE="${PALETTE:-cool}"
        RENDERING="${RENDERING:-digital}"
        TEXTLEVEL="${TEXTLEVEL:-title-only}"
        MOOD="${MOOD:-balanced}"
      fi
      if [[ -n "${CTYPE:-}" ]]; then
        direction_or_fail "${PRESETS_DIR}/cover-types.tsv" "$CTYPE" "type" >/dev/null || return 2
      fi
      if [[ -n "${PALETTE:-}" ]]; then
        direction_or_fail "${PRESETS_DIR}/cover-palettes.tsv" "$PALETTE" "palette" >/dev/null || return 2
      fi
      if [[ -n "${RENDERING:-}" ]]; then
        direction_or_fail "${PRESETS_DIR}/cover-renderings.tsv" "$RENDERING" "rendering" >/dev/null || return 2
      fi
      if [[ -n "${TEXTLEVEL:-}" ]]; then
        direction_or_fail "${PRESETS_DIR}/cover-text.tsv" "$TEXTLEVEL" "text" >/dev/null || return 2
      fi
      if [[ -n "${MOOD:-}" ]]; then
        direction_or_fail "${PRESETS_DIR}/cover-moods.tsv" "$MOOD" "mood" >/dev/null || return 2
      fi
      ;;
  esac
  return 0
}

# Pure: read resolved knobs → extra direction text (safe under $())
build_matrix_extra() {
  local extra="" d
  case "${KIND:-}" in
    xhs|xhs-cover)
      if [[ -n "${STYLE:-}" ]]; then
        d="$(direction_or_fail "${PRESETS_DIR}/xhs-styles.tsv" "$STYLE" "style")" || return 2
        extra+=" Visual style (${STYLE}): ${d}"
      fi
      if [[ -n "${LAYOUT:-}" ]]; then
        d="$(direction_or_fail "${PRESETS_DIR}/xhs-layouts.tsv" "$LAYOUT" "layout")" || return 2
        extra+=" Information layout (${LAYOUT}): ${d}"
      fi
      if [[ -n "${PALETTE:-}" ]]; then
        d="$(direction_or_fail "${PRESETS_DIR}/xhs-palettes.tsv" "$PALETTE" "palette")" || return 2
        extra+=" Color palette override (${PALETTE}): ${d}"
      fi
      ;;
    infographic)
      if [[ -n "${STYLE:-}" ]]; then
        d="$(direction_or_fail "${PRESETS_DIR}/infographic-styles.tsv" "$STYLE" "style")" || return 2
        extra+=" Infographic visual style (${STYLE}): ${d}"
      fi
      if [[ -n "${LAYOUT:-}" ]]; then
        d="$(direction_or_fail "${PRESETS_DIR}/infographic-layouts.tsv" "$LAYOUT" "layout")" || return 2
        extra+=" Infographic layout (${LAYOUT}): ${d}"
      fi
      ;;
    cover)
      if [[ -n "${CTYPE:-}" ]]; then
        d="$(direction_or_fail "${PRESETS_DIR}/cover-types.tsv" "$CTYPE" "type")" || return 2
        extra+=" Cover type (${CTYPE}): ${d}"
      fi
      if [[ -n "${PALETTE:-}" ]]; then
        d="$(direction_or_fail "${PRESETS_DIR}/cover-palettes.tsv" "$PALETTE" "palette")" || return 2
        extra+=" Cover palette (${PALETTE}): ${d}"
      fi
      if [[ -n "${RENDERING:-}" ]]; then
        d="$(direction_or_fail "${PRESETS_DIR}/cover-renderings.tsv" "$RENDERING" "rendering")" || return 2
        extra+=" Rendering (${RENDERING}): ${d}"
      fi
      if [[ -n "${TEXTLEVEL:-}" ]]; then
        d="$(direction_or_fail "${PRESETS_DIR}/cover-text.tsv" "$TEXTLEVEL" "text")" || return 2
        extra+=" Text treatment (${TEXTLEVEL}): ${d}"
      fi
      if [[ -n "${MOOD:-}" ]]; then
        d="$(direction_or_fail "${PRESETS_DIR}/cover-moods.tsv" "$MOOD" "mood")" || return 2
        extra+=" Mood (${MOOD}): ${d}"
      fi
      ;;
  esac
  printf '%s' "$extra"
}

compose_kind_prompt() {
  local kind="$1" user_prompt="$2"
  local line prefix matrix
  line="$(kind_line "$kind")" || return 1
  prefix="$(kind_field "$line" 7)"
  matrix="$(build_matrix_extra)" || return 2
  if [[ -n "$matrix" ]]; then
    printf '%s%s Subject/content from user: %s. High quality, coherent composition, no watermark. Do not invent dense unreadable paragraph text.' \
      "$prefix" "$matrix" "$user_prompt"
  else
    printf '%s Subject/content from user: %s. High quality, coherent composition, no watermark.' \
      "$prefix" "$user_prompt"
  fi
}

cmd_presets() {
  local domain="${1-}"
  if [[ -z "$domain" || "$domain" == "-h" || "$domain" == "--help" ]]; then
    cat <<EOF
List P0 style/layout matrices (baoyu-aligned knobs).

Usage:
  tzai-image presets xhs
  tzai-image presets infographic
  tzai-image presets cover

Then:
  tzai-image xhs --style notion --layout dense --prompt "..." --image out.png
  tzai-image xhs --preset knowledge-card --prompt "..." --image out.png
  tzai-image infographic --layout funnel --style tech-schematic --prompt "..." --image out.png
  tzai-image cover --type hero --palette dark --mood bold --text none --prompt "..." --image out.png
EOF
    return 0
  fi
  case "$domain" in
    xhs|xhs-cover|social)
      echo "== xhs styles =="
      list_preset_ids "${PRESETS_DIR}/xhs-styles.tsv"
      echo
      echo "== xhs layouts =="
      list_preset_ids "${PRESETS_DIR}/xhs-layouts.tsv"
      echo
      echo "== xhs palettes (optional) =="
      list_preset_ids "${PRESETS_DIR}/xhs-palettes.tsv"
      echo
      echo "== xhs named presets (--preset) =="
      awk -F'\t' '
        $0 ~ /^#/ || NF < 5 { next }
        { printf "%-18s style=%-12s layout=%-12s palette=%-8s %s\n", $1, $2, $3, ($4==""?"(style)":$4), $5 }
      ' "${PRESETS_DIR}/xhs-presets.tsv"
      echo
      echo "Workflow: ${WORKFLOWS_DIR}/xhs-series.md"
      ;;
    infographic|info)
      echo "== infographic styles =="
      list_preset_ids "${PRESETS_DIR}/infographic-styles.tsv"
      echo
      echo "== infographic layouts =="
      list_preset_ids "${PRESETS_DIR}/infographic-layouts.tsv"
      echo
      echo "Workflow: ${WORKFLOWS_DIR}/infographic-matrix.md"
      ;;
    cover)
      echo "== cover type =="
      list_preset_ids "${PRESETS_DIR}/cover-types.tsv"
      echo
      echo "== cover palette =="
      list_preset_ids "${PRESETS_DIR}/cover-palettes.tsv"
      echo
      echo "== cover rendering =="
      list_preset_ids "${PRESETS_DIR}/cover-renderings.tsv"
      echo
      echo "== cover text =="
      list_preset_ids "${PRESETS_DIR}/cover-text.tsv"
      echo
      echo "== cover mood =="
      list_preset_ids "${PRESETS_DIR}/cover-moods.tsv"
      echo
      echo "Workflow: ${WORKFLOWS_DIR}/cover-dimensions.md"
      ;;
    *)
      echo "Unknown presets domain: $domain (xhs|infographic|cover)" >&2
      return 2
      ;;
  esac
}

cmd_kinds() {
  local filter="${1-}"
  if [[ ! -f "$KINDS_FILE" ]]; then
    echo "Missing kinds catalog: $KINDS_FILE" >&2
    return 1
  fi
  if [[ -n "$filter" && "$filter" != "--help" && "$filter" != "-h" ]]; then
    local line
    line="$(kind_line "$filter")" || {
      echo "Unknown kind: $filter" >&2
      echo "Run: tzai-image kinds" >&2
      return 2
    }
    cat <<EOF
kind:        $(kind_field "$line" 1)
category:    $(kind_field "$line" 2) / $(kind_field "$line" 3)
default_ar:  $(kind_field "$line" 4)
label:       $(kind_field "$line" 5) / $(kind_field "$line" 6)
direction:   $(kind_field "$line" 7)
EOF
    case "$filter" in
      xhs|xhs-cover)
        cat <<EOF

Matrix knobs (P0):
  --style <id>    --layout <id>    --palette <id>    --preset <name>
  List: tzai-image presets xhs
  Series workflow: references/workflows/xhs-series.md
EOF
        ;;
      infographic)
        cat <<EOF

Matrix knobs (P0):
  --style <id>    --layout <id>
  List: tzai-image presets infographic
EOF
        ;;
      cover)
        cat <<EOF

Dimensions (P0, baoyu-like):
  --type --palette --rendering --text --mood
  List: tzai-image presets cover
EOF
        ;;
    esac
    cat <<EOF

Example:
  tzai-image generate --kind ${filter} --prompt \"your subject\" --image out.png
  tzai-image ${filter} --prompt \"your subject\" --image out.png
EOF
    return 0
  fi

  printf '%-14s %-12s %-6s %s\n' "KIND" "CATEGORY" "AR" "LABEL"
  printf '%-14s %-12s %-6s %s\n' "----" "--------" "--" "-----"
  awk -F'\t' '
    $0 ~ /^#/ || NF < 7 { next }
    {
      printf "%-14s %-12s %-6s %s / %s\n", $1, $2, $4, $5, $6
    }
  ' "$KINDS_FILE"
  cat <<EOF

Categories (功能分类):
  brand      品牌识别 — icon logo moodboard mascot badge avatar
  diagram    结构图示 — flowchart architecture mindmap diagram infographic dataviz
  product    产品设计 — ui wireframe empty-state onboarding
  marketing  市场内容 — slide banner email-header cover poster
  social     社交种草 — xhs xhs-cover wechat
  photo      影像插画 — product photo landscape illustration storybook food

P0 matrices:
  tzai-image presets xhs | infographic | cover

Usage:
  tzai-image kinds                 # list all
  tzai-image kinds flowchart       # detail one kind
  tzai-image generate --kind icon --prompt "spark for AI app" --image icon.png
  tzai-image xhs --style notion --layout dense --prompt "三步学会 Prompt" --image card.png
EOF
}

# ---------------------------------------------------------------------------
# init
# ---------------------------------------------------------------------------

cmd_init() {
  local api_key="" base_url="$DEFAULT_BASE_URL" model="" force=0 target="durable"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --api-key) require_val "$1" "${2-}"; api_key="$2"; shift 2 ;;
      --base-url) require_val "$1" "${2-}"; base_url="$2"; shift 2 ;;
      --model) require_val "$1" "${2-}"; model="$2"; shift 2 ;;
      --target) require_val "$1" "${2-}"; target="$2"; shift 2 ;;
      --force) force=1; shift ;;
      -h|--help)
        cat <<EOF
Usage: tzai-image init [options]

Save API credentials to a durable config file (not inside the skill package).

Get a key first: ${CONSOLE_URL}

Options:
  --api-key <sk-...>   TaoziAPI key (required)
  --base-url <url>     Default: ${DEFAULT_BASE_URL}
  --model <id>         Default image model (default if omitted: ${DEFAULT_IMAGE_MODEL})
  --target <where>     durable | global | local (default: durable)
  --force              Overwrite existing config

Alternatively, skip init and use a global env var:
  export TZAI_API_KEY='sk-...'
  # model defaults to ${DEFAULT_IMAGE_MODEL} unless you set TZAI_IMAGE_MODEL
EOF
        return 0
        ;;
      *) echo "Unknown init option: $1" >&2; return 2 ;;
    esac
  done

  if [[ -z "$api_key" ]]; then
    echo "Missing --api-key. Get one at ${CONSOLE_URL}" >&2
    return 2
  fi
  if [[ -z "$model" ]]; then
    model="${DEFAULT_IMAGE_MODEL}"
  fi

  local out_file
  case "$target" in
    durable) out_file="$DURABLE_CONFIG_FILE" ;;
    global) out_file="$GLOBAL_SHARED_CONFIG_FILE" ;;
    local) out_file="$LOCAL_CONFIG_FILE" ;;
    *) echo "Invalid --target: $target" >&2; return 2 ;;
  esac

  if [[ -f "$out_file" && "$force" -ne 1 ]]; then
    echo "Config already exists: $out_file" >&2
    echo "Re-run with --force to overwrite." >&2
    return 1
  fi

  mkdir -p "$(dirname -- "$out_file")"
  {
    echo "# Generated by: tzai-image init"
    echo "# Skill root: ${SKILL_ROOT}"
    echo "# Target: ${target}"
    echo "# Get / rotate keys: ${CONSOLE_URL}"
    echo "TZAI_BASE_URL=$(printf '%q' "${base_url%/}")"
    echo "TZAI_API_KEY=$(printf '%q' "$api_key")"
    echo "TZAI_IMAGE_MODEL=$(printf '%q' "$model")"
    echo "TZAI_DEFAULT_AR=$(printf '%q' "$DEFAULT_AR")"
    echo "TZAI_TIMEOUT_SEC=$(printf '%q' "$DEFAULT_TIMEOUT")"
  } >"$out_file"
  chmod 600 "$out_file" 2>/dev/null || true

  echo "Wrote ${out_file}"
  echo "API key: $(mask_key "$api_key")  (masked)"
  if [[ "$target" == "local" ]]; then
    echo "Note: local config is wiped by npx skills update. Prefer durable or export TZAI_API_KEY."
  else
    echo "This path survives npx skills update."
  fi
  echo "Tip: you can also use only:  export TZAI_API_KEY='sk-...'"
}

# ---------------------------------------------------------------------------
# doctor / which-config
# ---------------------------------------------------------------------------

cmd_doctor() {
  local strict=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --strict-auth) strict=1; shift ;;
      -h|--help)
        echo "Usage: tzai-image doctor [--strict-auth]"
        return 0
        ;;
      *) echo "Unknown doctor option: $1" >&2; return 2 ;;
    esac
  done

  load_all_configs
  local pass=0 fail=0 warn=0
  ok() { echo "  [OK]   $*"; pass=$((pass + 1)); }
  bad() { echo "  [FAIL] $*"; fail=$((fail + 1)); }
  wrn() { echo "  [WARN] $*"; warn=$((warn + 1)); }

  echo "tzai-image doctor  v$(skill_version)"
  echo "skill root: ${SKILL_ROOT}"
  echo

  echo "== tools =="
  if command -v python3 >/dev/null 2>&1; then
    ok "python3: $(command -v python3)"
  else
    bad "python3 missing (required for generate JSON handling)"
  fi
  if command -v curl >/dev/null 2>&1; then
    ok "curl: $(command -v curl)"
  else
    wrn "curl missing (used for strict-auth / models)"
  fi

  echo
  echo "== config =="
  print_config_paths
  echo
  echo "Effective (masked):"
  echo "  TZAI_BASE_URL=${TZAI_BASE_URL:-}  (source: ${BASE_SOURCE})"
  echo "  TZAI_API_KEY=$(mask_key "${TZAI_API_KEY-}")  (source: ${KEY_SOURCE})"
  echo "  TZAI_IMAGE_MODEL=${TZAI_IMAGE_MODEL:-"(unset)"}  (source: ${MODEL_SOURCE})"
  echo "  TZAI_DEFAULT_AR=${TZAI_DEFAULT_AR:-$DEFAULT_AR}"
  echo "  TZAI_TIMEOUT_SEC=${TZAI_TIMEOUT_SEC:-$DEFAULT_TIMEOUT}"
  echo

  if [[ -n "${TZAI_API_KEY-}" ]]; then
    ok "API key present (source: ${KEY_SOURCE})"
  else
    bad "API key missing"
    print_key_howto
  fi

  ok "image model: ${TZAI_IMAGE_MODEL}  (source: ${MODEL_SOURCE}; built-in best default: ${DEFAULT_IMAGE_MODEL})"

  if [[ "$strict" -eq 1 ]]; then
    echo
    echo "== strict auth (GET /v1/models) =="
    if [[ -z "${TZAI_API_KEY-}" ]]; then
      bad "cannot strict-auth without API key"
    elif ! command -v curl >/dev/null 2>&1; then
      bad "curl required for --strict-auth"
    else
      local code body
      body="$(curl -sS -o /tmp/tzai-doctor-models.$$ -w "%{http_code}" \
        --max-time "${TZAI_TIMEOUT_SEC:-$DEFAULT_TIMEOUT}" \
        -H "Authorization: Bearer ${TZAI_API_KEY}" \
        "${TZAI_BASE_URL}/v1/models" 2>/dev/null || echo "000")"
      code="$body"
      if [[ "$code" == "200" ]]; then
        ok "GET /v1/models → 200"
      else
        bad "GET /v1/models → HTTP ${code} (check key at ${CONSOLE_URL})"
        head -c 300 /tmp/tzai-doctor-models.$$ 2>/dev/null >&2 || true
        echo >&2
      fi
      rm -f /tmp/tzai-doctor-models.$$ 2>/dev/null || true
    fi
  fi

  echo
  echo "Results: ${pass} ok, ${warn} warn, ${fail} fail"
  [[ "$fail" -eq 0 ]] || return 1
  return 0
}

cmd_which_config() {
  load_all_configs
  print_config_paths
  echo
  echo "Effective:"
  echo "  key_source=${KEY_SOURCE}  key=$(mask_key "${TZAI_API_KEY-}")"
  echo "  base_url=${TZAI_BASE_URL}  (source: ${BASE_SOURCE})"
  echo "  model=${TZAI_IMAGE_MODEL:-"(unset)"}  (source: ${MODEL_SOURCE})"
  echo "  ar=${TZAI_DEFAULT_AR:-$DEFAULT_AR}"
  echo "  timeout=${TZAI_TIMEOUT_SEC:-$DEFAULT_TIMEOUT}"
}

# ---------------------------------------------------------------------------
# models
# ---------------------------------------------------------------------------

cmd_models() {
  load_all_configs
  if [[ -z "${TZAI_API_KEY-}" ]]; then
    print_key_howto
    return 2
  fi
  if ! command -v curl >/dev/null 2>&1; then
    echo "curl required for models" >&2
    return 1
  fi
  local tmp
  tmp="$(mktemp)"
  local code
  code="$(curl -sS -o "$tmp" -w "%{http_code}" \
    --max-time "${TZAI_TIMEOUT_SEC:-$DEFAULT_TIMEOUT}" \
    -H "Authorization: Bearer ${TZAI_API_KEY}" \
    "${TZAI_BASE_URL}/v1/models" || true)"
  if [[ "$code" != "200" ]]; then
    echo "GET /v1/models failed: HTTP ${code}" >&2
    head -c 500 "$tmp" >&2 || true
    echo >&2
    rm -f "$tmp"
    return 1
  fi
  if command -v python3 >/dev/null 2>&1; then
    python3 - "$tmp" <<'PY'
import json, sys
path = sys.argv[1]
data = json.load(open(path))
items = data.get("data") or data.get("models") or []
if isinstance(items, dict):
    items = list(items.values())
ids = []
for it in items:
    if isinstance(it, dict):
        mid = it.get("id") or it.get("name")
        if mid:
            ids.append(str(mid))
    elif isinstance(it, str):
        ids.append(it)
for mid in sorted(set(ids)):
    print(mid)
if not ids:
    print(json.dumps(data, ensure_ascii=False, indent=2)[:4000])
PY
  else
    cat "$tmp"
  fi
  rm -f "$tmp"
}

# ---------------------------------------------------------------------------
# generate
# ---------------------------------------------------------------------------

cmd_generate() {
  local prompt="" image="" model="" size="" ar="" api_key="" base_url="" kind="" dry_run=0 json_out=0 n=1
  local user_prompt="" final_prompt="" kind_ar="" kind_label=""
  # Matrix knobs: NOT local — shared with build_matrix_extra / apply_xhs_named_preset
  STYLE=""; LAYOUT=""; PALETTE=""; PRESET=""
  CTYPE=""; RENDERING=""; TEXTLEVEL=""; MOOD=""
  KIND=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --prompt|-p) require_val "$1" "${2-}"; prompt="$2"; shift 2 ;;
      --image|-o) require_val "$1" "${2-}"; image="$2"; shift 2 ;;
      --model|-m) require_val "$1" "${2-}"; model="$2"; shift 2 ;;
      --size) require_val "$1" "${2-}"; size="$2"; shift 2 ;;
      --ar) require_val "$1" "${2-}"; ar="$2"; shift 2 ;;
      --kind|-k) require_val "$1" "${2-}"; kind="$2"; shift 2 ;;
      --style) require_val "$1" "${2-}"; STYLE="$2"; shift 2 ;;
      --layout) require_val "$1" "${2-}"; LAYOUT="$2"; shift 2 ;;
      --palette) require_val "$1" "${2-}"; PALETTE="$2"; shift 2 ;;
      --preset) require_val "$1" "${2-}"; PRESET="$2"; shift 2 ;;
      --type) require_val "$1" "${2-}"; CTYPE="$2"; shift 2 ;;
      --rendering) require_val "$1" "${2-}"; RENDERING="$2"; shift 2 ;;
      --text) require_val "$1" "${2-}"; TEXTLEVEL="$2"; shift 2 ;;
      --mood) require_val "$1" "${2-}"; MOOD="$2"; shift 2 ;;
      --api-key) require_val "$1" "${2-}"; api_key="$2"; shift 2 ;;
      --base-url) require_val "$1" "${2-}"; base_url="$2"; shift 2 ;;
      --n) require_val "$1" "${2-}"; n="$2"; shift 2 ;;
      --dry-run) dry_run=1; shift ;;
      --json) json_out=1; shift ;;
      -h|--help)
        cat <<EOF
Usage: tzai-image generate [options]
   or: tzai-image <kind> --prompt "..." --image out.png

Scenario kinds (功能分类，类似 baoyu-xhs / infographic / diagram):
  tzai-image kinds
  tzai-image presets xhs|infographic|cover

Options:
  --kind, -k <id>       Scenario preset (icon|logo|flowchart|xhs|infographic|...)
  --prompt, -p <text>   Subject / content (required). Kind adds professional art direction.
  --image, -o <path>    Output file path (required unless --dry-run)
  --model, -m <id>      Model id (default: ${DEFAULT_IMAGE_MODEL})
  --size <WxH>          e.g. 1024x1024
  --ar <ratio>          Override kind default aspect ratio
  --style <id>          P0 matrix: xhs / infographic visual style
  --layout <id>         P0 matrix: xhs / infographic layout
  --palette <id>        P0 matrix: xhs color override OR cover palette
  --preset <name>       P0 named combo (xhs presets)
  --type <id>           P0 cover type (hero|minimal|...)
  --rendering <id>      P0 cover rendering
  --text <id>           P0 cover text level (none|title-only|...)
  --mood <id>           P0 cover mood
  --api-key <sk-...>    Override key for this call
  --base-url <url>      Override gateway
  --n <count>           Number of images (default 1; only first saved if >1)
  --dry-run             Print plan only (no network)
  --json                Print JSON metadata on stdout after success

Examples:
  tzai-image generate --kind icon --prompt "spark for AI coding app" --image icon.png
  tzai-image flowchart --prompt "signup to activation funnel" --image flow.png
  tzai-image xhs --style notion --layout dense --prompt "三步写好周报" --image card.png
  tzai-image xhs --preset knowledge-card --prompt "三步写好周报" --image card.png
  tzai-image infographic --layout funnel --style tech-schematic --prompt "转化漏斗" --image f.png
  tzai-image cover --type hero --palette dark --mood bold --text none --prompt "可观测性" --image c.png

Config:
  export TZAI_API_KEY='sk-...'
  Default model: ${DEFAULT_IMAGE_MODEL}
  Key console: ${CONSOLE_URL}
EOF
        return 0
        ;;
      *) echo "Unknown generate option: $1" >&2; return 2 ;;
    esac
  done

  load_all_configs

  if [[ -n "$api_key" ]]; then
    TZAI_API_KEY="$api_key"
    KEY_SOURCE="cli"
  fi
  if [[ -n "$base_url" ]]; then
    TZAI_BASE_URL="${base_url%/}"
    BASE_SOURCE="cli"
  fi
  if [[ -n "$model" ]]; then
    TZAI_IMAGE_MODEL="$model"
    MODEL_SOURCE="cli"
  fi

  user_prompt="$prompt"
  final_prompt="$prompt"

  if [[ -n "$kind" ]]; then
    local kline
    kline="$(kind_line "$kind")" || {
      echo "Unknown --kind: $kind (try: tzai-image kinds)" >&2
      return 2
    }
    kind_ar="$(kind_field "$kline" 4)"
    kind_label="$(kind_field "$kline" 5)"
    KIND="$kind"
    # Resolve presets/defaults in this shell before any $(...) subshell
    resolve_matrix_knobs || return 2
    final_prompt="$(compose_kind_prompt "$kind" "$user_prompt")" || return 2
    if [[ -z "$ar" && -n "$kind_ar" ]]; then
      ar="$kind_ar"
    fi
  elif [[ -n "${STYLE}${LAYOUT}${PALETTE}${PRESET}${CTYPE}${RENDERING}${TEXTLEVEL}${MOOD}" ]]; then
    echo "Matrix flags require --kind (or kind subcommand like: xhs --style notion ...)" >&2
    return 2
  fi

  if [[ -n "$ar" ]]; then
    TZAI_DEFAULT_AR="$ar"
  fi
  if [[ -z "$size" ]]; then
    size="$(ar_to_size "${TZAI_DEFAULT_AR:-$DEFAULT_AR}")"
  fi

  if [[ -z "$user_prompt" ]]; then
    echo "Missing --prompt (subject/content for the image)" >&2
    return 2
  fi
  if [[ "$dry_run" -ne 1 && -z "$image" ]]; then
    echo "Missing --image output path" >&2
    return 2
  fi
  if [[ "$dry_run" -ne 1 && -z "${TZAI_API_KEY-}" ]]; then
    print_key_howto
    return 2
  fi
  # Model always resolves (built-in best default at minimum)
  TZAI_IMAGE_MODEL="${TZAI_IMAGE_MODEL:-$DEFAULT_IMAGE_MODEL}"

  local url="${TZAI_BASE_URL}/v1/images/generations"
  local model_eff="${TZAI_IMAGE_MODEL:-"(unset)"}"
  prompt="$final_prompt"

  local matrix_summary=""
  [[ -n "${STYLE:-}" ]] && matrix_summary+=" style=${STYLE}"
  [[ -n "${LAYOUT:-}" ]] && matrix_summary+=" layout=${LAYOUT}"
  [[ -n "${PALETTE:-}" ]] && matrix_summary+=" palette=${PALETTE}"
  [[ -n "${PRESET:-}" ]] && matrix_summary+=" preset=${PRESET}"
  [[ -n "${CTYPE:-}" ]] && matrix_summary+=" type=${CTYPE}"
  [[ -n "${RENDERING:-}" ]] && matrix_summary+=" rendering=${RENDERING}"
  [[ -n "${TEXTLEVEL:-}" ]] && matrix_summary+=" text=${TEXTLEVEL}"
  [[ -n "${MOOD:-}" ]] && matrix_summary+=" mood=${MOOD}"

  if [[ "$dry_run" -eq 1 ]]; then
    cat <<EOF >&2
[dry-run] tzai-image v$(skill_version)
[dry-run] POST ${url}
[dry-run] kind=${kind:-"(none)"}${kind_label:+ ($kind_label)}
[dry-run] matrix:${matrix_summary:-" (none)"}
[dry-run] model=${model_eff}  (source: ${MODEL_SOURCE})
[dry-run] size=${size}  ar=${TZAI_DEFAULT_AR:-$DEFAULT_AR}
[dry-run] n=${n}
[dry-run] output=${image:-"(none)"}
[dry-run] api_key=$(mask_key "${TZAI_API_KEY-}")  (source: ${KEY_SOURCE})
[dry-run] base_url=${TZAI_BASE_URL}  (source: ${BASE_SOURCE})
[dry-run] user_prompt_chars=${#user_prompt}  final_prompt_chars=${#final_prompt}
[dry-run] not calling network
EOF
    if [[ "$json_out" -eq 1 ]]; then
      python3 - <<PY
import json
print(json.dumps({
  "dry_run": True,
  "url": "${url}",
  "kind": """${kind}""",
  "style": """${STYLE}""",
  "layout": """${LAYOUT}""",
  "palette": """${PALETTE}""",
  "preset": """${PRESET}""",
  "type": """${CTYPE}""",
  "rendering": """${RENDERING}""",
  "text": """${TEXTLEVEL}""",
  "mood": """${MOOD}""",
  "model": "${model_eff}",
  "size": "${size}",
  "ar": """${TZAI_DEFAULT_AR:-$DEFAULT_AR}""",
  "output": """${image}""",
  "final_prompt": """${final_prompt}""",
}, ensure_ascii=False))
PY
    fi
    return 0
  fi

  if ! command -v python3 >/dev/null 2>&1; then
    echo "python3 required for generate" >&2
    return 1
  fi
  if ! command -v curl >/dev/null 2>&1; then
    echo "curl required for generate" >&2
    return 1
  fi

  mkdir -p "$(dirname -- "$image")"

  local req_json resp_file code
  req_json="$(mktemp)"
  resp_file="$(mktemp)"
  python3 - "$req_json" "$prompt" "$TZAI_IMAGE_MODEL" "$size" "$n" <<'PY'
import json, sys
path, prompt, model, size, n = sys.argv[1:6]
body = {
    "model": model,
    "prompt": prompt,
    "n": int(n),
    "size": size,
    "response_format": "b64_json",
}
with open(path, "w", encoding="utf-8") as f:
    json.dump(body, f, ensure_ascii=False)
PY

  code="$(curl -sS -o "$resp_file" -w "%{http_code}" \
    --max-time "${TZAI_TIMEOUT_SEC:-$DEFAULT_TIMEOUT}" \
    -X POST "$url" \
    -H "Authorization: Bearer ${TZAI_API_KEY}" \
    -H "Content-Type: application/json" \
    --data-binary @"$req_json" || echo "000")"

  rm -f "$req_json"

  if [[ "$code" != "200" ]]; then
    echo "Image generation failed: HTTP ${code}" >&2
    head -c 800 "$resp_file" >&2 || true
    echo >&2
    if [[ "$code" == "401" || "$code" == "403" ]]; then
      echo "Check API key at ${CONSOLE_URL}" >&2
    fi
    rm -f "$resp_file"
    return 1
  fi

  python3 - "$resp_file" "$image" <<'PY'
import base64, json, sys, urllib.request
resp_path, out_path = sys.argv[1], sys.argv[2]
data = json.load(open(resp_path, encoding="utf-8"))
items = data.get("data") or []
if not items:
    # some gateways nest differently
    if isinstance(data.get("data"), dict):
        items = [data["data"]]
    else:
        raise SystemExit("No data[] in API response: " + json.dumps(data)[:500])
first = items[0]
if first.get("b64_json"):
    raw = base64.b64decode(first["b64_json"])
    open(out_path, "wb").write(raw)
elif first.get("url"):
    urllib.request.urlretrieve(first["url"], out_path)
else:
    raise SystemExit("No b64_json or url in response item: " + json.dumps(first)[:500])
print(out_path)
PY

  local written
  written="$(python3 -c "import json;print(json.load(open('${resp_file}')).get('data',[{}])[0].get('revised_prompt',''))" 2>/dev/null || true)"
  rm -f "$resp_file"

  echo "Wrote ${image}" >&2
  echo "Using ${TZAI_BASE_URL} / ${TZAI_IMAGE_MODEL}${kind:+ / kind=${kind}}" >&2

  if [[ "$json_out" -eq 1 ]]; then
    python3 - <<PY
import json
print(json.dumps({
  "ok": True,
  "path": """${image}""",
  "model": """${TZAI_IMAGE_MODEL}""",
  "kind": """${kind}""",
  "base_url": """${TZAI_BASE_URL}""",
  "size": """${size}""",
}, ensure_ascii=False))
PY
  else
    printf '%s\n' "$image"
  fi
}

# ---------------------------------------------------------------------------
# help
# ---------------------------------------------------------------------------

print_help() {
  cat <<EOF
tzai-image v$(skill_version) — TaoziAPI image engine with scenario kinds

Modules (分类功能，对齐 baoyu 场景 skill 思路，集于一个 CLI):
  brand      icon logo moodboard mascot badge avatar
  diagram    flowchart architecture mindmap diagram infographic dataviz
  product    ui wireframe empty-state onboarding
  marketing  slide banner email-header cover poster
  social     xhs xhs-cover wechat          # 小红书 / 微信
  photo      product photo landscape illustration storybook food

Usage:
  tzai-image kinds
  tzai-image kinds xhs
  tzai-image presets xhs|infographic|cover
  tzai-image generate --kind flowchart --prompt "注册到激活" --image flow.png
  tzai-image xhs --style notion --layout dense --prompt "三步写周报" --image card.png
  tzai-image infographic --layout funnel --style tech-schematic --prompt "转化" --image f.png
  tzai-image cover --type hero --palette dark --text none --prompt "主题" --image c.png
  tzai-image icon --prompt "AI coding spark" --image icon.png
  tzai-image init --api-key sk-...
  tzai-image doctor [--strict-auth]
  tzai-image models
  tzai-image --version

API key:
  export TZAI_API_KEY='sk-...'   OR   tzai-image init --api-key sk-...
  Console: ${CONSOLE_URL}
  Default model: ${DEFAULT_IMAGE_MODEL}
EOF
}

# ---------------------------------------------------------------------------
# dispatch
# ---------------------------------------------------------------------------

cmd="${1:-}"
case "$cmd" in
  -h|--help|help)
    print_help
    exit 0
    ;;
  --version|version|-V)
    echo "tzai-image v$(skill_version)"
    exit 0
    ;;
  init)
    shift
    cmd_init "$@"
    exit $?
    ;;
  doctor)
    shift
    cmd_doctor "$@"
    exit $?
    ;;
  which-config)
    shift
    cmd_which_config "$@"
    exit $?
    ;;
  config-path|paths)
    print_config_paths
    exit 0
    ;;
  models)
    shift
    cmd_models "$@"
    exit $?
    ;;
  kinds|kind)
    shift
    cmd_kinds "$@"
    exit $?
    ;;
  presets|preset|styles)
    shift
    cmd_presets "$@"
    exit $?
    ;;
  generate|gen)
    shift
    cmd_generate "$@"
    exit $?
    ;;
  "")
    print_help
    exit 0
    ;;
  *)
    # Scenario alias: tzai-image flowchart --prompt ... 
    if kind_line "$cmd" >/dev/null 2>&1; then
      shift
      cmd_generate --kind "$cmd" "$@"
      exit $?
    fi
    # allow bare generate flags for convenience
    if [[ "$cmd" == --* ]]; then
      cmd_generate "$@"
      exit $?
    fi
    echo "Unknown command: $cmd" >&2
    echo "Try: tzai-image kinds" >&2
    print_help >&2
    exit 2
    ;;
esac

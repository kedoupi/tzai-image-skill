#!/usr/bin/env python3
"""Offline catalog and asset-plan validator for tzai-image agents."""

from __future__ import annotations

import argparse
import csv
import json
import os
import sys
from pathlib import Path, PurePosixPath


SKILL_ROOT = Path(__file__).resolve().parent.parent
REFS = SKILL_ROOT / "references"
WORKFLOWS_DIR = REFS / "workflows"
PATTERNS_DIR = REFS / "patterns"
VALID_STATUSES = {"stable", "guided", "expert-review"}
VALID_APPROVALS = {"pending", "approved", "rejected"}
VALID_ARS = {"1:1", "16:9", "9:16", "3:4"}
VALID_ASSET_STATUSES = {
    "planned",
    "anchor-generated",
    "approved-for-batch",
    "generated",
    "rejected",
    "regenerate",
    "failed",
}


class ValidationError(Exception):
    pass


def split_values(value: str) -> list[str]:
    return [part.strip() for part in value.split(";") if part.strip()]


def read_tsv(path: Path) -> tuple[list[str], list[dict[str, str]]]:
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError as exc:
        raise ValidationError(f"cannot read {path}: {exc}") from exc
    if not lines or not lines[0].startswith("# "):
        raise ValidationError(f"{path}: first line must be a '# ' TSV header")
    header = lines[0][2:].split("\t")
    rows: list[dict[str, str]] = []
    for line_no, line in enumerate(lines[1:], start=2):
        if not line.strip() or line.startswith("#"):
            continue
        values = next(csv.reader([line], delimiter="\t"))
        if len(values) != len(header):
            raise ValidationError(
                f"{path}:{line_no}: expected {len(header)} fields, got {len(values)}"
            )
        row = dict(zip(header, values))
        if any(not value.strip() for value in values):
            raise ValidationError(f"{path}:{line_no}: fields may not be empty")
        rows.append(row)
    return header, rows


def unique_index(rows: list[dict[str, str]], what: str) -> dict[str, dict[str, str]]:
    result: dict[str, dict[str, str]] = {}
    for row in rows:
        ident = row["id"]
        if ident in result:
            raise ValidationError(f"duplicate {what} id: {ident}")
        result[ident] = row
    return result


def load_catalogs() -> tuple[dict[str, dict[str, str]], dict[str, dict[str, str]], set[str]]:
    _, workflow_rows = read_tsv(WORKFLOWS_DIR / "index.tsv")
    _, pattern_rows = read_tsv(PATTERNS_DIR / "index.tsv")
    _, kind_rows = read_tsv(REFS / "kinds.tsv")
    workflows = unique_index(workflow_rows, "workflow")
    patterns = unique_index(pattern_rows, "pattern")
    kinds = set(unique_index(kind_rows, "kind"))

    for pattern_id, row in patterns.items():
        if row["status"] not in VALID_STATUSES:
            raise ValidationError(f"pattern {pattern_id}: invalid status {row['status']}")
        unknown = set(split_values(row["compatible_kinds"])) - kinds
        if unknown:
            raise ValidationError(f"pattern {pattern_id}: unknown kinds {sorted(unknown)}")
        if not (PATTERNS_DIR / row["reference_doc"]).is_file():
            raise ValidationError(f"pattern {pattern_id}: missing {row['reference_doc']}")

    for workflow_id, row in workflows.items():
        if row["status"] not in VALID_STATUSES:
            raise ValidationError(f"workflow {workflow_id}: invalid status {row['status']}")
        try:
            minimum, maximum = int(row["min_assets"]), int(row["max_assets"])
        except ValueError as exc:
            raise ValidationError(f"workflow {workflow_id}: invalid asset limits") from exc
        if minimum < 1 or maximum < minimum:
            raise ValidationError(f"workflow {workflow_id}: invalid asset range {minimum}..{maximum}")
        unknown_patterns = set(split_values(row["pattern_ids"])) - set(patterns)
        if unknown_patterns:
            raise ValidationError(
                f"workflow {workflow_id}: unknown patterns {sorted(unknown_patterns)}"
            )
        unknown_kinds = set(split_values(row["kinds"])) - kinds
        if unknown_kinds:
            raise ValidationError(f"workflow {workflow_id}: unknown kinds {sorted(unknown_kinds)}")
        for module in split_values(row["modules"].replace(",", ";")):
            if not (WORKFLOWS_DIR / "modules" / f"{module}.md").is_file():
                raise ValidationError(f"workflow {workflow_id}: missing module {module}.md")
        if not (WORKFLOWS_DIR / row["guide"]).is_file():
            raise ValidationError(f"workflow {workflow_id}: missing guide {row['guide']}")

    return workflows, patterns, kinds


def require_string(obj: dict, field: str) -> str:
    value = obj.get(field)
    if not isinstance(value, str) or not value.strip():
        raise ValidationError(f"{field} must be a non-empty string")
    return value


def safe_output(project_root: Path, relative: str) -> Path:
    pure = PurePosixPath(relative)
    if not pure.parts or pure == PurePosixPath(".") or pure.is_absolute() or ".." in pure.parts:
        raise ValidationError(f"unsafe output path: {relative}")
    root = project_root.resolve()
    candidate = root.joinpath(*pure.parts)
    current = root
    for part in pure.parts[:-1]:
        current = current / part
        if current.is_symlink():
            raise ValidationError(f"output traverses symlink: {current}")
    try:
        candidate.resolve(strict=False).relative_to(root)
    except ValueError as exc:
        raise ValidationError(f"output escapes project root: {relative}") from exc
    return candidate


def validate_plan(
    plan_path: Path,
    workflows: dict[str, dict[str, str]],
    kinds: set[str],
    mode: str,
) -> dict:
    try:
        plan = json.loads(plan_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise ValidationError(f"cannot parse plan {plan_path}: {exc}") from exc
    if not isinstance(plan, dict):
        raise ValidationError("plan must be a JSON object")
    if plan.get("schema_version") != "1":
        raise ValidationError("schema_version must be '1'")
    workflow_id = require_string(plan, "workflow_id")
    if workflow_id not in workflows:
        raise ValidationError(f"unknown workflow_id: {workflow_id}")
    workflow = workflows[workflow_id]
    root_value = require_string(plan, "project_root")
    require_string(plan, "shared_style_token")
    project_root = Path(root_value)
    if not project_root.is_absolute():
        project_root = plan_path.parent / project_root
    if project_root.is_symlink():
        raise ValidationError(f"project_root must not be a symlink: {project_root}")
    approval = plan.get("approval")
    if not isinstance(approval, dict):
        raise ValidationError("approval must be an object")
    for stage in ("plan", "anchor"):
        if approval.get(stage) not in VALID_APPROVALS:
            raise ValidationError(f"approval.{stage} must be pending, approved, or rejected")
    if mode in {"anchor", "batch"} and approval["plan"] != "approved":
        raise ValidationError("plan approval is required before anchor generation")
    if mode == "batch" and approval["anchor"] != "approved":
        raise ValidationError("anchor approval is required before batch generation")
    if mode == "batch" and workflow["status"] == "expert-review":
        if approval.get("expert_review") != "approved":
            raise ValidationError("expert review approval is required for this workflow")

    assets = plan.get("assets")
    if not isinstance(assets, list) or not assets:
        raise ValidationError("assets must be a non-empty array")
    minimum, maximum = int(workflow["min_assets"]), int(workflow["max_assets"])
    if not minimum <= len(assets) <= maximum:
        raise ValidationError(
            f"workflow {workflow_id} requires {minimum}..{maximum} assets, got {len(assets)}"
        )

    ids: set[str] = set()
    sequences: set[int] = set()
    outputs: set[str] = set()
    anchors: list[dict] = []
    allowed_kinds = set(split_values(workflow["kinds"]))
    output_paths: dict[str, Path] = {}
    for index, asset in enumerate(assets, start=1):
        if not isinstance(asset, dict):
            raise ValidationError(f"asset {index} must be an object")
        asset_id = require_string(asset, "id")
        if asset_id in ids:
            raise ValidationError(f"duplicate asset id: {asset_id}")
        ids.add(asset_id)
        sequence = asset.get("sequence")
        if not isinstance(sequence, int) or isinstance(sequence, bool) or sequence < 1:
            raise ValidationError(f"asset {asset_id}: sequence must be a positive integer")
        if sequence in sequences:
            raise ValidationError(f"duplicate asset sequence: {sequence}")
        sequences.add(sequence)
        kind = require_string(asset, "kind")
        if kind not in kinds:
            raise ValidationError(f"asset {asset_id}: unknown kind {kind}")
        if kind not in allowed_kinds:
            raise ValidationError(
                f"asset {asset_id}: kind {kind} is not allowed by workflow {workflow_id}"
            )
        require_string(asset, "role")
        status = require_string(asset, "status")
        if status not in VALID_ASSET_STATUSES:
            raise ValidationError(f"asset {asset_id}: invalid status {status}")
        if asset.get("ar") not in VALID_ARS:
            raise ValidationError(f"asset {asset_id}: unsupported ar {asset.get('ar')}")
        require_string(asset, "prompt_subject")
        output = require_string(asset, "output")
        if output in outputs:
            raise ValidationError(f"duplicate output path: {output}")
        outputs.add(output)
        output_path = safe_output(project_root, output)
        output_paths[asset_id] = output_path
        if "force" in asset and not isinstance(asset["force"], bool):
            raise ValidationError(f"asset {asset_id}: force must be boolean")
        anchor = asset.get("anchor")
        if not isinstance(anchor, bool):
            raise ValidationError(f"asset {asset_id}: anchor must be boolean")
        if anchor:
            anchors.append(asset)
        dependencies = asset.get("depends_on")
        if not isinstance(dependencies, list) or not all(isinstance(dep, str) for dep in dependencies):
            raise ValidationError(f"asset {asset_id}: depends_on must be a string array")

    if len(anchors) != 1:
        raise ValidationError(f"plan must contain exactly one anchor, got {len(anchors)}")
    anchor_id = anchors[0]["id"]
    if anchors[0]["sequence"] != min(sequences):
        raise ValidationError("anchor must be the first asset")
    for asset in assets:
        if asset["id"] == anchor_id:
            if asset["depends_on"]:
                raise ValidationError("anchor must not depend on another asset")
        elif anchor_id not in asset["depends_on"]:
            raise ValidationError(f"asset {asset['id']}: must depend on anchor {anchor_id}")
        unknown_dependencies = set(asset["depends_on"]) - ids
        if unknown_dependencies:
            raise ValidationError(
                f"asset {asset['id']}: unknown dependencies {sorted(unknown_dependencies)}"
            )

    anchor_asset = anchors[0]
    anchor_output = output_paths[anchor_id]
    if mode == "anchor":
        if anchor_asset["status"] not in {"planned", "regenerate"}:
            raise ValidationError("anchor must be planned or regenerate before anchor generation")
        if anchor_output.exists() and not anchor_asset.get("force", False):
            raise ValidationError("anchor output exists without force=true")
    elif mode == "batch":
        if anchor_asset["status"] != "anchor-generated":
            raise ValidationError("batch requires anchor status anchor-generated")
        if not anchor_output.is_file() or anchor_output.is_symlink():
            raise ValidationError("batch requires the generated anchor output to exist as a regular file")
        for asset in assets:
            if asset["id"] == anchor_id:
                continue
            if asset["status"] != "approved-for-batch":
                raise ValidationError(
                    f"asset {asset['id']}: batch requires status approved-for-batch"
                )
            path = output_paths[asset["id"]]
            if path.exists() and not asset.get("force", False):
                raise ValidationError(
                    f"asset {asset['id']}: output exists without force=true: {asset['output']}"
                )
    else:
        for asset in assets:
            path = output_paths[asset["id"]]
            if path.exists() and not asset.get("force", False):
                raise ValidationError(
                    f"asset {asset['id']}: output exists without force=true: {asset['output']}"
                )

    return {
        "ok": True,
        "workflow_id": workflow_id,
        "workflow_status": workflow["status"],
        "mode": mode,
        "asset_count": len(assets),
        "anchor_id": anchor_id,
        "readiness": "ready-for-batch" if mode == "batch" else "ready-for-anchor" if mode == "anchor" else "valid",
    }


def main() -> int:
    parser = argparse.ArgumentParser(description="Validate tzai-image workflow catalogs and plans offline.")
    parser.add_argument("plan", nargs="?", type=Path, help="asset-plan.json to validate")
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--for-anchor", action="store_true", help="require approved plan")
    mode.add_argument("--for-batch", action="store_true", help="require approved plan and anchor")
    parser.add_argument("--catalog-only", action="store_true", help="validate catalogs without a plan")
    parser.add_argument("--json", action="store_true", help="emit JSON result")
    args = parser.parse_args()
    try:
        workflows, patterns, kinds = load_catalogs()
        if args.catalog_only:
            result = {
                "ok": True,
                "workflows": len(workflows),
                "patterns": len(patterns),
                "kinds": len(kinds),
            }
        else:
            if args.plan is None:
                parser.error("plan is required unless --catalog-only is used")
            selected_mode = "batch" if args.for_batch else "anchor" if args.for_anchor else "validate"
            result = validate_plan(args.plan, workflows, kinds, selected_mode)
        if args.json:
            print(json.dumps(result, ensure_ascii=False, sort_keys=True))
        else:
            print("OK " + " ".join(f"{key}={value}" for key, value in result.items() if key != "ok"))
        return 0
    except ValidationError as exc:
        if args.json:
            print(json.dumps({"ok": False, "error": str(exc)}, ensure_ascii=False))
        else:
            print(f"ERROR {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())

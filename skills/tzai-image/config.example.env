# Example config for tzai-image (copy via `tzai-image init`, do not commit real keys)
#
# Get a key: https://tzai.kdp.cool/console
#
# Recommended path (default for init):
#   ~/.config/kedoupi/tzai-image/config.env
#
# Load order (later wins among files, then process env / CLI):
#   legacy XDG / .skill-data → kedoupi config → config.local.env
#   → $TZAI_IMAGE_CONFIG → process env (TZAI_*) → CLI
#
# Prefer init over shell rc. CI-only alternative:
#   export TZAI_API_KEY='sk-...'

TZAI_BASE_URL='https://tzai.kdp.cool'
TZAI_API_KEY='sk-your-key-here'
# Built-in best default is gpt-image-2; override only if you want another model
TZAI_IMAGE_MODEL='gpt-image-2'
TZAI_DEFAULT_AR='1:1'
TZAI_TIMEOUT_SEC='120'

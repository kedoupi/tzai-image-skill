{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kedoupi/tzai-image-skill/schemas/asset-plan.schema.json",
  "title": "tzai-image asset plan",
  "type": "object",
  "required": [
    "schema_version",
    "workflow_id",
    "project_root",
    "shared_style_token",
    "approval",
    "assets"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "workflow_id": {"type": "string", "minLength": 1},
    "project_root": {"type": "string", "minLength": 1},
    "shared_style_token": {"type": "string"},
    "approval": {
      "type": "object",
      "required": ["plan", "anchor"],
      "properties": {
        "plan": {"enum": ["pending", "approved", "rejected"]},
        "anchor": {"enum": ["pending", "approved", "rejected"]},
        "expert_review": {"enum": ["not-required", "pending", "approved", "rejected"]}
      },
      "additionalProperties": true
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "sequence",
          "role",
          "kind",
          "ar",
          "prompt_subject",
          "output",
          "anchor",
          "depends_on",
          "status"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "sequence": {"type": "integer", "minimum": 1},
          "role": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "ar": {"enum": ["1:1", "16:9", "9:16", "3:4"]},
          "prompt_subject": {"type": "string", "minLength": 1},
          "content_ref": {"type": "string"},
          "copy_overlay": {"type": "string"},
          "image_text": {"enum": ["none", "short", "title-only", "external"]},
          "output": {"type": "string", "minLength": 1},
          "anchor": {"type": "boolean"},
          "depends_on": {"type": "array", "items": {"type": "string"}},
          "status": {
            "enum": [
              "planned",
              "anchor-generated",
              "approved-for-batch",
              "generated",
              "rejected",
              "regenerate",
              "failed"
            ]
          },
          "force": {"type": "boolean"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
